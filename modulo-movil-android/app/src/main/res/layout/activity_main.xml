<?xml version="1.0" encoding="utf-8"?>
<!--
  Módulo: Inventario (versión móvil)
  Propósito: Layout de la pantalla principal: encabezado, listado de
             productos (RecyclerView) y botón para registrar uno nuevo.
  Autora: Viviana Arias Montilla
  Fecha de creación: 2026-08-30
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorFondo">

    <TextView
        android:id="@+id/tituloApp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimario"
        android:padding="16dp"
        android:text="@string/titulo_app"
        android:textColor="@color/colorTextoClaro"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/subtituloApp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimario"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:text="@string/subtitulo_inventario"
        android:textColor="@color/colorAcento"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tituloApp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerProductos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:padding="12dp"
        app:layout_constraintBottom_toTopOf="@id/botonNuevoProducto"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/subtituloApp" />

    <Button
        android:id="@+id/botonNuevoProducto"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:backgroundTint="@color/colorPrimario"
        android:padding="12dp"
        android:text="@string/boton_nuevo_producto"
        android:textColor="@color/colorTextoClaro"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
